NODE_ENV=development
HOST=0.0.0.0
PORT=9000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pop_ladle
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Outbound email (invites). Leave RESEND_API_KEY blank to use the console
# transport in dev — invite emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Pop & Ladle <onboarding@resend.dev>
# Public app origin used to build absolute invite links in emails.
APP_BASE_URL=http://localhost:5173

# --- Early-access subscribers (popladle.com) ---------------------------------
# Signup, double opt-in, thank-you preference, unsubscribe and the contact form.
# Subscriber email, contacts and sequences run on Plunk; see
# src/features/subscribers/README.md for the Plunk setup.
#   MARKETING_SITE_URL       public site origin used in confirm/preferences links
#   SUBSCRIBER_TOKEN_SECRET  32+ chars; signs preference/unsubscribe links.
#                            Blank = subscriber endpoints return 503. Rotating it
#                            breaks every unsubscribe link already emailed.
#   PLUNK_SECRET_KEY         sk_... (Plunk → Settings → API Keys)
#   PLUNK_PUBLIC_KEY         pk_... from the same page; /v1/track takes only this.
#                            Both blank = console transport (logged, not sent).
#   PLUNK_WEBHOOK_SECRET     32+ chars; Plunk's Webhook steps send it as
#                            "Authorization: Bearer <secret>"
#   PLUNK_API_URL            defaults to https://next-api.useplunk.com
#   PLUNK_CONFIRMATION_TEMPLATE_ID, PLUNK_WELCOME_TEMPLATE_ID
#                            optional; default to the live Pop & Ladle templates
#   SUBSCRIBER_GUIDE_KEY     the guide PDF's object key in S3_BUCKET (R2)
#   CONTACT_INBOX            where contact-form messages go (blank = form returns 503;
#                            the contact form still sends through Resend)
MARKETING_SITE_URL=http://localhost:3000
SUBSCRIBER_TOKEN_SECRET=
PLUNK_SECRET_KEY=
PLUNK_PUBLIC_KEY=
PLUNK_WEBHOOK_SECRET=
SUBSCRIBER_GUIDE_KEY=
CONTACT_INBOX=

# Temporary whole-app password gate. Keep this only on the backend. Empty = off.
# Changing the password invalidates every existing gate session immediately.
FRONTEND_GATE_PASSWORD=
# Stable random signing secret; set once and keep private. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FRONTEND_GATE_SESSION_SECRET=
# How long a correct password unlocks the browser before asking again.
FRONTEND_GATE_SESSION_HOURS=12

# Encryption secret for platform LLM provider API keys stored in the DB
# (platform_provider_keys, managed via /admin/provider-keys and /admin/roster).
# Any long random string; used to derive an AES-256-GCM key. If UNSET, the
# provider-key WRITE endpoints return 503 (fail closed — nothing is ever stored
# in plaintext) and the recipe-brain proxy falls back to the *_API_KEY env vars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_KEY_ENC_SECRET=

# Recipe Brain provider keys — legacy env fallback (used when no DB key is set
# for a provider/specialist). Production prefers DB-managed keys above.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Object storage for recipe photos (S3-compatible — Cloudflare R2).
# Private bucket; leave blank to disable photo features (endpoints return 503).
# R2 endpoint looks like https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Stripe billing (server-side only) ---------------------------------------
# Leave blank to disable billing: checkout/portal/webhook return 503
# BILLING_NOT_CONFIGURED and the rest of the API works normally. The SPA needs
# no Stripe key — checkout is a hosted redirect via the backend.
#   STRIPE_SECRET_KEY      sk_test_... (dashboard.stripe.com → Developers → API keys)
#   STRIPE_WEBHOOK_SECRET  whsec_... — locally from:
#                            stripe listen --forward-to localhost:9000/api/v1/billing/webhook
#                          in production from the registered webhook endpoint
#                          https://<api-host>/api/v1/billing/webhook
#   STRIPE_API_VERSION     optional — blank uses the SDK's pinned default.
# After setting keys: enable the Customer Portal in Stripe settings, then run
# "Sync catalog to Stripe" once from /admin/billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
